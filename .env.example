# ==============================================================================
# AgentPay Gateway & Console Deployment Environment Configuration
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# Docker Image Tag and Registry
IMAGE_TAG=latest
DOCKER_REGISTRY=openagentpay

# PostgreSQL Configuration
POSTGRES_DB=agentpay
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=agentpay_strong_password_change_in_prod
POSTGRES_PORT=5432

# AgentPay Gateway Configuration
GATEWAY_PORT=8000
# IMPORTANT: Provide a random high-entropy secret string (min 32 chars) in production!
AGENTPAY_JWT_SECRET=agentpay-super-secret-production-jwt-key-32chars!
# Master encryption key for upstream auth secrets (AES-256 key, minimum 32 bytes or 64 hex characters)
AGENTPAY_UPSTREAM_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# API key used by Gateway to authenticate to Facilitator
AGENTPAY_FACILITATOR_API_KEY=agentpay_facilitator_secret_key_change_in_prod
LOG_LEVEL=info

# AgentPay Console (Web UI) Port (set to 3000 or 8080 if host port 80 is occupied by nginx)
CONSOLE_PORT=3000

# AgentPay Marketplace (Public Storefront & GEO Portal) Port
MARKETPLACE_PORT=3001

# AgentPay Facilitator Configuration
FACILITATOR_PORT=8001
# API key required by Facilitator to accept verify and settle requests
FACILITATOR_API_KEY=agentpay_facilitator_secret_key_change_in_prod
# IMPORTANT: Set this to your facilitator node's private key for on-chain settlement.
# Never commit real private keys to version control!
# FACILITATOR_PRIVATE_KEY=

# EVM / Blockchain Configuration
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# CHAIN_ID=421614
# USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

