# ==============================================================================
# AgentPay Gateway & Console Deployment Environment Configuration
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# Docker Image Tag and Registry
IMAGE_TAG=latest
DOCKER_REGISTRY=openagentpay

# PostgreSQL Configuration
POSTGRES_DB=agentpay
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=agentpay_strong_password_change_in_prod
POSTGRES_PORT=5432

# AgentPay Gateway Configuration
GATEWAY_PORT=8000
# IMPORTANT: Provide a random high-entropy secret string (min 32 chars) in production!
AGENTPAY_JWT_SECRET=agentpay-super-secret-production-jwt-key-32chars!
LOG_LEVEL=info

# AgentPay Console (Web UI) Port (set to 3000 or 8080 if host port 80 is occupied by nginx)
CONSOLE_PORT=3000
