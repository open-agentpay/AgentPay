{
  "name": "open-agentpay",
  "version": "0.2.7",
  "description": "The Open-Source Financial Firewall & Micro-Payment Infrastructure for Autonomous AI Agents (TypeScript SDK)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js",
      "default": "./dist/evm/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js",
      "default": "./dist/policy/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js",
      "default": "./dist/state/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "import": "./dist/integrations/index.js",
      "default": "./dist/integrations/index.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js",
      "default": "./dist/integrations/langchain.js"
    },
    "./vercel-ai": {
      "types": "./dist/integrations/vercel-ai.d.ts",
      "import": "./dist/integrations/vercel-ai.js",
      "default": "./dist/integrations/vercel-ai.js"
    },
    "./mcp": {
      "types": "./dist/integrations/mcp.d.ts",
      "import": "./dist/integrations/mcp.js",
      "default": "./dist/integrations/mcp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "x402",
    "usdc",
    "eip-712",
    "eip-3009",
    "financial-firewall",
    "arbitrum",
    "langchain",
    "mcp"
  ],
  "author": "AgentPay Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-agentpay/AgentPay.git"
  },
  "homepage": "https://openagentpay.dev/",
  "bugs": {
    "url": "https://github.com/open-agentpay/AgentPay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "11.7.0",
    "viem": "2.21.54"
  }
}
