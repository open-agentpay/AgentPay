{
  "name": "open-agentpay",
  "version": "0.3.0",
  "description": "The Open-Source Financial Firewall & Micro-Payment Infrastructure for Autonomous AI Agents (TypeScript SDK)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js",
      "default": "./dist/evm/index.js"
    },
    "./core": "agentpay-core-sdk/core",
    "./policy": "agentpay-core-sdk/policy",
    "./client": "agentpay-core-sdk/client",
    "./state": "agentpay-core-sdk/state",
    "./integrations": "agentpay-core-sdk/integrations"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "demo": "node --experimental-strip-types examples/demo.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "x402",
    "usdc",
    "eip-712",
    "eip-3009",
    "financial-firewall",
    "arbitrum",
    "langchain",
    "mcp"
  ],
  "author": "AgentPay Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-agentpay/AgentPay.git"
  },
  "homepage": "https://openagentpay.dev/",
  "bugs": {
    "url": "https://github.com/open-agentpay/AgentPay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "agentpay-core-sdk": "^0.3.0",
    "better-sqlite3": "11.7.0",
    "viem": "2.21.54"
  }
}
